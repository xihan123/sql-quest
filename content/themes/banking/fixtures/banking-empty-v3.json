{
  "schemaVersion": 1,
  "id": "banking-empty-v3",
  "tables": [
    {
      "name": "customers",
      "description": "银行客户档案，一行一名客户。姓名可能重名，以编号区分。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "客户编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "客户姓名，虚构人物，可能重名"
        },
        {
          "name": "city",
          "type": "TEXT",
          "description": "所在城市"
        },
        {
          "name": "credit_level",
          "type": "TEXT",
          "description": "信用等级：A / B / C"
        }
      ],
      "rows": []
    },
    {
      "name": "accounts",
      "description": "账户记录，一行一个账户。同一客户可开多个账户，余额与类型按账户分别记录。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "账户编号"
        },
        {
          "name": "customer_id",
          "type": "INTEGER",
          "description": "开户客户编号，指向 customers.id",
          "references": {
            "table": "customers",
            "column": "id"
          }
        },
        {
          "name": "account_type",
          "type": "TEXT",
          "description": "账户类型：活期 / 定期 / 理财"
        },
        {
          "name": "balance",
          "type": "INTEGER",
          "minimum": 0,
          "description": "余额，整数元"
        },
        {
          "name": "opened_at",
          "type": "TEXT",
          "description": "开户日期，固定为 YYYY-MM-DD 文本"
        },
        {
          "name": "status",
          "type": "TEXT",
          "description": "状态：正常 / 冻结"
        }
      ],
      "rows": []
    },
    {
      "name": "transactions",
      "description": "账户流水，每行记录一笔交易。memo 为 SQL NULL 表示没有存储备注值；空字符串 '' 是零长度文本值，与 SQL NULL 不同。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "流水编号"
        },
        {
          "name": "account_id",
          "type": "INTEGER",
          "description": "账户编号，指向 accounts.id",
          "references": {
            "table": "accounts",
            "column": "id"
          }
        },
        {
          "name": "kind",
          "type": "TEXT",
          "description": "类型：转账 / 消费 / 存入"
        },
        {
          "name": "amount",
          "type": "INTEGER",
          "minimum": 0,
          "description": "金额，整数元，可能为 0"
        },
        {
          "name": "occurred_at",
          "type": "TEXT",
          "description": "发生日期，固定为 YYYY-MM-DD 文本"
        },
        {
          "name": "memo",
          "type": "TEXT",
          "nullable": true,
          "description": "备注值；SQL NULL 表示没有存储值，'' 表示零长度文本。两者均与非空备注文本不同。"
        }
      ],
      "rows": []
    }
  ],
  "indexes": [
    {
      "name": "accounts_opened_at",
      "table": "accounts",
      "columns": [
        {
          "name": "opened_at",
          "direction": "DESC"
        }
      ]
    }
  ]
}
