        [59, 40, "转账", 5000, "2025-07-22", "还款"],
        [60, 31, "转账", 2500, "2025-07-25", null],
        [61, 33, "消费", 300, "2025-07-28", null],
        [62, 31, "转账", 0, "2025-08-01", ""]
      ]
    }
  ],
  "indexes": [
    {
      "name": "accounts_opened_at",
      "table": "accounts",
      "columns": [
        {
          "name": "opened_at",
          "direction": "DESC"
        }
      ]
    }
  ]
}
