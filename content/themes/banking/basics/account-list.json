  "title": "查看账户",
  "prerequisites": [],
  "concepts": ["select"],
  "introducedConcepts": ["select"],
  "objective": "读取完整账户清单，区分账户编号与客户编号。",
  "statement": "查看 accounts 中的所有账户，依次输出 id、customer_id、account_type、balance、opened_at、status，保留原列名。正常、冻结账户都要列出，行顺序不限。",
  "knowledge": [
    "accounts 每行代表一个账户。id 是该账户的唯一编号；customer_id 标明账户属于谁。客户 1 名下的账户 1 和 11 分别占一行。",
    "FROM accounts 指定账户表，SELECT * 按表结构读出全部六列。星号管的是读哪些列，不会按状态筛选。",
    "账户 5 和 10 的 status 是冻结，但仍登记在账户表里；读取完整清单时它们也在结果中。"
  ],
  "readableTables": ["accounts"],
  "previewFixtureId": "banking-main-v3",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 查看账户表的全部行和全部列。\n",
  "hints": [
    {
      "id": "idea",
      "text": "只读账户清单即可，同一客户的各个账户和冻结账户都留下。"
    },
    {
      "id": "syntax",
      "text": "SELECT * 读取全部列，FROM 后写清单所在的表。"
    },
    {
      "id": "skeleton",
      "text": "SELECT * FROM ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT * FROM accounts;",
      "explanation": "星号展开为 accounts 定义的六列。这里没有按客户合并，也没有按账户状态筛选。"
    }
  ],
