{
  "schemaVersion": 1,
  "id": "clinic-alt-v2",
  "tables": [
    {
      "name": "patients",
      "description": "门诊患者档案，每行一名患者；从未就诊的患者也在此表。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "患者编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "患者姓名"
        },
        {
          "name": "gender",
          "type": "TEXT",
          "description": "性别：男 / 女"
        },
        {
          "name": "birth_year",
          "type": "INTEGER",
          "minimum": 1900,
          "description": "出生年份"
        },
        {
          "name": "phone",
          "type": "TEXT",
          "nullable": true,
          "description": "联系电话；NULL 表示未登记"
        }
      ],
      "rows": [
        [21, "沈丽", "女", 1979, null],
        [22, "曹阳", "男", 1983, "13900000022"],
        [23, "邓超", "男", 1965, null],
        [24, "许晴", "女", 1991, "13900000024"],
        [25, "苏敏", "女", 1987, "13900000025"],
        [26, "卢凯", "男", 1970, null],
        [27, "姚婷", "女", 1998, "13900000027"],
        [28, "崔浩", "男", 1994, null]
      ]
    },
    {
      "name": "doctors",
      "description": "门诊医生名单，每行一位医生。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "医生编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "医生姓名"
        },
        {
          "name": "title",
          "type": "TEXT",
          "description": "职称：主任医师 / 副主任医师 / 主治医师"
        },
        {
          "name": "department",
          "type": "TEXT",
          "description": "所属科室"
        }
      ],
      "rows": [
        [11, "白露", "主任医师", "内科"],
        [12, "胡适", "副主任医师", "外科"],
        [13, "程远", "主治医师", "内科"]
      ]
    },
    {
      "name": "visits",
      "description": "就诊记录，一行一次就诊；同一患者可多次就诊。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "就诊记录编号"
        },
        {
          "name": "patient_id",
          "type": "INTEGER",
          "description": "就诊患者编号，指向 patients.id",
          "references": {
            "table": "patients",
            "column": "id"
          }
        },
        {
          "name": "doctor_id",
          "type": "INTEGER",
          "description": "接诊医生编号，指向 doctors.id",
          "references": {
            "table": "doctors",
            "column": "id"
          }
        },
        {
          "name": "visit_date",
          "type": "TEXT",
          "description": "就诊日期，固定为 YYYY-MM-DD 文本"
        },
        {
          "name": "department",
          "type": "TEXT",
          "description": "就诊科室"
        },
        {
          "name": "fee",
          "type": "INTEGER",
          "minimum": 0,
          "description": "本次门诊费用，整数元"
        }
      ],
      "rows": [
        [31, 22, 11, "2025-04-02", "内科", 300],
        [32, 21, 13, "2025-04-02", "内科", 80],
        [33, 24, 12, "2025-04-08", "外科", 460],
        [34, 24, 11, "2025-04-08", "内科", 300],
        [35, 26, 13, "2025-04-12", "内科", 150],
        [36, 25, 12, "2025-04-12", "外科", 520],
        [37, 27, 12, "2025-04-15", "外科", 300],
        [38, 23, 11, "2025-04-20", "内科", 210],
        [39, 27, 12, "2025-04-20", "外科", 140]
      ]
    }
  ],
  "indexes": [
    {
      "name": "visits_date",
      "table": "visits",
      "columns": [
        {
          "name": "visit_date",
          "direction": "DESC"
        }
      ]
    }
  ]
}
