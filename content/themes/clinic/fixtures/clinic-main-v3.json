        [9, 7, 2, "2025-03-10", "外科", 520],
        [10, 1, 3, "2025-03-15", "皮肤科", 90],
        [11, 5, 3, "2025-03-15", "皮肤科", 300],
        [12, 6, 1, "2025-03-20", "内科", 410]
