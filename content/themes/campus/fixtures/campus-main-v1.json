{
  "schemaVersion": 1,
  "id": "campus-main-v1",
  "tables": [
    {
      "name": "students",
      "description": "在校学生，每行一名学生。姓名可能相同，以编号区分；没有选课记录的学生也保留在此表。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "学号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "学生姓名，不保证唯一"
        },
        {
          "name": "gender",
          "type": "TEXT",
          "description": "性别：男 / 女"
        },
        {
          "name": "grade",
          "type": "INTEGER",
          "minimum": 1,
          "description": "年级，1 至 4"
        },
        {
          "name": "phone",
          "type": "TEXT",
          "nullable": true,
          "description": "联系电话，虚构号码；NULL 表示未登记"
