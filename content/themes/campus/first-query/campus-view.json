  "flowchart": {
    "exampleSql": "SELECT * FROM students;",
    "nodes": [
      {
        "id": "topic",
        "label": "读懂这条查询",
        "description": "读取学生表的全部字段，各分支说明数据来源、列和记录。"
      },
      {
        "id": "source",
        "label": "从哪里读？\nFROM students",
        "description": "FROM students 指定数据来源是学生表。逻辑上先确定数据来源，再确定输出；但 SQL 书写时 SELECT 在 FROM 前面。"
      },
      {
        "id": "columns",
        "label": "输出哪些列？\nSELECT *",
        "description": "星号表示按表结构的列顺序输出 id、name、gender、grade、phone 五列，不是只输出姓名。"
      },
      {
        "id": "identity",
        "label": "一行代表什么？\n一名学生",
        "description": "id 是学号，区分同名学生；姓名相同仍是不同的行，不能合并。"
      },
      {
        "id": "records",
        "label": "保留哪些记录？\n全部学生",
        "description": "这条查询没有筛选条件，电话未登记的学生也保留；没有学生时输出零行，但仍保留五个列名。"
      },
      {
        "id": "row-order",
        "label": "行按什么顺序？\n没有保证",
        "description": "查询没有指定排序，不要把预览中的插入顺序理解为查询始终保证的输出顺序。列的先后与行的先后是两回事。"
      }
    ],
