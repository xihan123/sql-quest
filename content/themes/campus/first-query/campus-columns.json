          ["陈静", 3],
          ["杨帆", 2],
          ["周婷", 3],
          ["吴迪", 1]
        ]
      }
    },
    {
      "id": "case-2",
      "fixtureId": "campus-main-varied-v1",
      "expected": {
        "columns": ["name", "grade"],
        "rows": [
          ["王强", 2],
          ["刘洋", 3],
          ["王强", 1]
        ]
      }
