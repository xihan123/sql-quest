  "id": "dish-columns",
  "revision": 3,
  "dialect": "sqlite",
  "mode": "guided",
  "title": "菜品字段与列别名",
  "prerequisites": ["dish-list"],
  "concepts": ["select", "select-columns", "column-alias"],
  "introducedConcepts": ["select-columns", "column-alias"],
  "objective": "挑选菜品编号、单价和分类并命名结果列。",
  "statement": "从 dishes 输出菜品编号、当前菜单单价和分类，依次命名为 dish_id、price_yuan、dish_category；每道菜一行。",
  "knowledge": [
    "id、price、category 分别存菜品编号、整数元当前单价和类别；给输出字段起别名不改变这些值。",
    "列别名通常写成 price AS price_yuan；SQLite 允许省略 AS，只要结果列名和顺序符合题意即可。",
    "同类别的菜各自保留一行，不能因为 category 相同就合并；本题没有聚合或去重。"
  ],
  "readableTables": ["dishes"],
  "previewFixtureId": "restaurant-main-v2",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 输出菜品编号、单价和分类，并使用题目要求的列名。\n",
  "hints": [
    {
      "id": "idea",
      "text": "按顺序选出菜品编号、单价、分类，并检查三列结果名称。"
    },
    {
      "id": "syntax",
      "text": "字段名后可以用 AS 设置列别名，字段间用逗号分隔；省略 AS 在 SQLite 中也有效。"
    },
    {
      "id": "skeleton",
      "text": "SELECT id AS dish_id, price AS ____, category AS ____ FROM dishes;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT id AS dish_id, price AS price_yuan, category AS dish_category FROM dishes;",
      "explanation": "依次输出 id、price 和 category，并设置题目指定的结果表头；AS 只命名结果列，price 仍是菜单当前单价。"
    }
  ],
