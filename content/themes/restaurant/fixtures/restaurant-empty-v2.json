{
  "schemaVersion": 1,
  "id": "restaurant-empty-v2",
  "tables": [
    {
      "name": "dishes",
      "description": "在售菜品，一行一道菜。category 为热菜 / 凉菜 / 主食 / 饮品；spicy_level 是 1–3 级辣度，NULL 表示未标注；price 为整数元。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "菜品编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "菜品名称"
        },
        {
          "name": "category",
          "type": "TEXT",
          "description": "分类：热菜 / 凉菜 / 主食 / 饮品"
        },
        {
          "name": "price",
          "type": "INTEGER",
          "minimum": 0,
          "description": "单价，整数元"
        },
        {
          "name": "spicy_level",
          "type": "INTEGER",
          "minimum": 1,
          "nullable": true,
          "description": "辣度 1–3；NULL 表示未标注"
        }
      ],
      "rows": []
    },
    {
      "name": "orders",
      "description": "门店订单，一行一笔。table_no 是桌号，同一桌可多次下单；ordered_at 为 YYYY-MM-DD 文本日期；status 为已完成 / 进行中 / 已取消。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "订单编号"
        },
        {
          "name": "table_no",
          "type": "INTEGER",
          "minimum": 1,
          "description": "桌号"
        },
        {
          "name": "ordered_at",
          "type": "TEXT",
          "description": "下单日期，固定为 YYYY-MM-DD 文本"
        },
        {
          "name": "status",
          "type": "TEXT",
          "description": "状态：已完成 / 进行中 / 已取消"
        }
      ],
      "rows": []
    },
    {
      "name": "order_items",
      "description": "订单明细，一行点了一道菜。order_id 指向订单，dish_id 指向菜品，quantity 是份数（≥1）；同一道菜可出现在多笔订单。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "明细编号"
        },
        {
          "name": "order_id",
          "type": "INTEGER",
          "description": "订单编号，指向 orders.id",
          "references": {
            "table": "orders",
            "column": "id"
          }
        },
        {
          "name": "dish_id",
          "type": "INTEGER",
          "description": "菜品编号，指向 dishes.id",
          "references": {
            "table": "dishes",
            "column": "id"
          }
        },
        {
          "name": "quantity",
          "type": "INTEGER",
          "minimum": 1,
          "description": "份数"
        }
      ],
      "rows": []
    }
  ],
  "indexes": [
    {
      "name": "orders_date",
      "table": "orders",
      "columns": [
        {
          "name": "ordered_at",
          "direction": "DESC"
        }
      ]
    }
  ]
}
