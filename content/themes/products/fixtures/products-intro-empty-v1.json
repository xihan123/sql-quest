{
  "schemaVersion": 1,
  "id": "products-intro-empty-v1",
  "tables": [
    {
      "name": "products",
      "description": "虚构的空商品目录，表结构仍然存在，但没有商品记录。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "商品编号，唯一标识一条商品记录"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "商品名称，不保证唯一"
        },
        {
          "name": "category",
          "type": "TEXT",
          "description": "商品类别"
        },
        {
          "name": "price",
          "type": "INTEGER",
          "minimum": 0,
          "description": "商品单价，单位为整数元；0 表示免费，不表示缺失"
        },
        {
          "name": "stock",
          "type": "INTEGER",
          "minimum": 0,
          "description": "库存件数；0 表示暂时无库存，仍是目录中的商品"
        }
      ],
      "rows": []
    }
  ]
}
