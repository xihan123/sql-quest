  "id": "batch-columns",
  "revision": 3,
  "dialect": "sqlite",
  "mode": "guided",
  "title": "批次字段与列别名",
  "prerequisites": [
    "line-list"
  ],
  "concepts": [
    "select",
    "select-columns",
    "column-alias"
