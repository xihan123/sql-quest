      "name": "production_lines",
      "description": "生产线档案，一行一条产线。workshop 是所属车间，同一车间可有多条产线，名称相近时以 id 区分。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "产线编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "产线名称"
        },
        {
          "name": "workshop",
          "type": "TEXT",
          "description": "所属车间"
        }
      ],
      "rows": [
