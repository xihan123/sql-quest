    {
      "name": "batches",
      "description": "生产批次，一行一个批次。line_id 指向产线，product 是产品名称，produced_at 为 YYYY-MM-DD 文本，quantity 是生产件数，defect_rate 为不良率百分比（1.85 表示 1.85%，NULL 表示尚未评估）。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "批次编号"
        },
        {
          "name": "line_id",
          "type": "INTEGER",
          "description": "产线编号，指向 production_lines.id",
          "references": {
            "table": "production_lines",
            "column": "id"
          }
        },
        {
          "name": "product",
          "type": "TEXT",
          "description": "产品名称"
        },
        {
          "name": "produced_at",
          "type": "TEXT",
          "description": "生产日期，固定为 YYYY-MM-DD 文本"
        },
        {
          "name": "quantity",
          "type": "INTEGER",
          "minimum": 0,
          "description": "生产数量，件"
        },
        {
          "name": "defect_rate",
          "type": "REAL",
          "minimum": 0,
          "nullable": true,
          "description": "不良率百分比数值，1.85 表示 1.85%；0 表示已测得零不良率；NULL 表示尚未评估"
        }
      ],
