  "objective": "查看菜品表的全部字段和记录。",
  "statement": "查看 dishes 中全部在售菜品，按表结构顺序输出 id、name、category、price、spicy_level 五列，列名保持原样。未标注辣度的菜也输出；不要求行顺序，空表仍返回五列列名。",
  "knowledge": [
    "SELECT * FROM dishes 按表结构顺序展开五列，输出所有菜品，不筛选分类或行。",
    "spicy_level 允许 NULL，NULL 表示尚未标注，不表示 0 级辣；整数 0 和 SQL NULL 是不同值（本表的已知辣度取 1–3）。",
    "例如清蒸鲈鱼当前菜单价为 88 元，酸梅汤为 12 元；这是菜品当前单价，不是订单实收金额。没有 ORDER BY 时行顺序不作保证。"
  ],
  "readableTables": [
    "dishes"
  ],
  "previewFixtureId": "restaurant-main-v2",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 查看菜品表的全部行和全部列。\n",
  "hints": [
    {
      "id": "idea",
      "text": "本题要看整张在售菜品表，保留包括辣度未标注在内的全部记录。"
    },
    {
      "id": "syntax",
      "text": "SELECT * 取表的全部字段，FROM dishes 指定菜品表；输出列顺序来自表结构。"
    },
    {
      "id": "skeleton",
      "text": "SELECT * FROM ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT * FROM dishes;",
      "explanation": "星号按 dishes 的定义输出五列，所有在售菜品原样保留；NULL 辣度仍是未标注值，price 是当前菜单单价。"
    }
  ],
