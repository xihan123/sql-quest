  "id": "high-salary",
  "revision": 3,
  "dialect": "sqlite",
  "mode": "guided",
  "title": "高薪员工",
  "prerequisites": [
    "employee-columns"
  ],
  "concepts": [
    "select",
    "select-columns",
    "where-compare"
  ],
  "introducedConcepts": [
    "where-compare"
  ],
  "objective": "使用包含边界的比较条件筛选月薪。",
  "statement": "列出月薪不低于 9000 元的员工，输出 id、name、salary。9000 元整也符合条件；姓名可能重名，各条员工记录分别保留，不要求行顺序。",
  "knowledge": [
    "salary 存的是整数元，9000 不加引号；WHERE salary >= 9000 按每条员工记录判断条件。",
    ">= 表示大于或等于，包含边界；employees 中刘敏和孙鹏都是 9000 元，写 > 9000 会漏掉两人。",
    "WHERE 负责筛行，SELECT 决定输出 id、name、salary 三列；id 标识员工，所以同名员工仍能分别识别。"
  ],
  "readableTables": [
    "employees"
  ],
  "previewFixtureId": "hr-main-v2",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 找出月薪不低于 9000 元的员工。\n",
  "hints": [
    {
      "id": "idea",
      "text": "筛的是每名员工的月薪，先确认“不低于”包含恰好 9000 元的边界。"
    },
    {
      "id": "syntax",
      "text": "WHERE 后写 salary >= 9000；>= 包含等于，数值不需要单引号。"
    },
    {
      "id": "skeleton",
      "text": "SELECT id, name, salary FROM employees WHERE ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT id, name, salary FROM employees WHERE salary >= 9000;",
      "explanation": "WHERE salary >= 9000 按月薪保留边界值和更高值，再按要求输出员工编号、姓名与月薪。"
    }
  ],
