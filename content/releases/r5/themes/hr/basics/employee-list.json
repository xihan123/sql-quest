    "select"
  ],
  "objective": "查看员工表的完整结构和全部员工记录。",
  "statement": "查看 employees 的全部记录，按表结构顺序输出 id、department_id、name、hire_date、salary、phone 六列，保留原列名。未登记电话的 phone 为 SQL NULL；不要求行顺序，空表返回零行但保留六列列名。",
  "knowledge": [
    "SELECT * FROM employees; 会按建表顺序展开六列；星号只表示取列，不负责排序或筛行。",
    "员工姓名不唯一：id 8 和 10 都叫李娜，分别属于不同部门、入职时间也不同。要识别员工用 id，不能把相同姓名当成同一人。",
    "phone 的 SQL NULL 表示未登记。空字符串和文本“NULL”都是实际存入的文本，不能当成 SQL NULL；没有 ORDER BY 时也不承诺员工行顺序。"
  ],
  "readableTables": [
    "employees"
  ],
  "previewFixtureId": "hr-main-v2",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 查看员工表的全部行和全部列。\n",
  "hints": [
    {
      "id": "idea",
      "text": "题目要求整张员工表；先核对表名和六列顺序，不需要筛选或排序。"
    },
    {
      "id": "syntax",
      "text": "SELECT * 从一张表选出所有字段，FROM employees 指定数据表；星号展开顺序由表结构决定。"
    },
    {
      "id": "skeleton",
      "text": "SELECT * FROM ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT * FROM employees;",
      "explanation": "FROM employees 指向员工档案，星号展开表定义中的六列，所有员工都保留。两名李娜仍是两条记录；phone 的 NULL 也原样显示。"
    }
  ],
