    {
      "name": "employees",
      "description": "员工档案，一行一名员工。姓名可能重复，以编号区分；phone 为 NULL 表示未登记电话。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "员工编号"
        },
        {
          "name": "department_id",
          "type": "INTEGER",
          "description": "所属部门编号，指向 departments.id",
          "references": {
            "table": "departments",
            "column": "id"
