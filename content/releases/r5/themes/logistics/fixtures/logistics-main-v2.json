    {
      "name": "carriers",
      "description": "承运商档案，每行一家承运商；服务等级只有标准与加急。",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primaryKey": true,
          "description": "承运商编号"
        },
        {
          "name": "name",
          "type": "TEXT",
          "description": "承运商名称"
        },
        {
          "name": "service_level",
          "type": "TEXT",
          "description": "服务等级：标准 / 加急"
        }
      ],
      "rows": [
        [
          1,
          "顺达快递",
          "标准"
        ],
        [
          2,
          "云翼速运",
          "加急"
        ],
        [
          3,
