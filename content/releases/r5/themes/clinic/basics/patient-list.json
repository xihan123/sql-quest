  "title": "查看患者档案",
  "prerequisites": [],
  "concepts": [
    "select"
  ],
  "introducedConcepts": [
    "select"
  ],
  "objective": "读出患者档案中的全部行和字段。",
  "statement": "查看 patients 中的全部患者档案，依次输出 id、name、gender、birth_year、phone，保留原列名。没有登记电话或没有就诊记录的患者也要列出。行顺序不限。",
  "knowledge": [
    "patients 每行是一份患者档案。id 是唯一的患者编号，name 是姓名，birth_year 只记录出生年份。",
    "phone 存的是电话号码文本。李强的 phone 为 NULL，表示没有登记电话，他的档案仍是一条完整的查询结果。",
    "FROM patients 指定读取患者表，SELECT * 按表中定义的顺序输出五列。表中没有档案时，结果保留这五个列名，行数为零。"
  ],
  "readableTables": [
    "patients"
  ],
  "previewFixtureId": "clinic-main-v3",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 查看患者档案的全部行和全部列。\n",
  "hints": [
    {
      "id": "idea",
      "text": "查档案时，电话号码缺失的那一行也要留下。想想有没有必要挑列或筛行。"
    },
    {
      "id": "syntax",
      "text": "用 SELECT * 取全部列，FROM 后接档案所在的表名。"
    },
    {
      "id": "skeleton",
      "text": "SELECT * FROM ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT * FROM patients;",
      "explanation": "这条查询直接读取 patients 的每条档案。星号展开为五列，患者有没有电话或就诊记录都不影响他是否出现在结果里。"
    }
  ],
