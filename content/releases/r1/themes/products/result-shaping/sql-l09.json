  "introducedConcepts": [
    "order-by"
  ],
  "objective": "按价格降序、编号升序确定结果的完整行顺序。",
  "statement": "输出全部商品的 id、name、price，按 price 降序、id 升序排列。未知价格 NULL 排在已知价格之后，多个 NULL 也按 id 升序。免费、缺货商品和重复记录都要保留。",
  "knowledge": [
    "ORDER BY 放在查询后部；ASC 是升序，DESC 是降序，每个排序字段单独指定方向。没有 ORDER BY 不能保证行顺序。",
    "多个排序键以逗号分隔：先比较第一个键，相同才比较下一个。主键 id 唯一，作为最后一个键可以消除并列的不确定性。",
    "SQLite 默认排序中 NULL 小于非 NULL，因此 ASC 时在前，DESC 时在后。本关不通过 WHERE 排除未知价格。",
    "索引、插入或预览顺序不能代替 ORDER BY；SELECT 的列顺序也不是行的排序规则。"
  ],
  "readableTables": [
    "products"
  ],
  "previewFixtureId": "products-catalog-v1",
  "duplicatePolicy": "preserve",
  "starterSql": "-- 按价格降序、编号升序确定结果的完整行顺序。\n",
  "flowchart": {
    "exampleSql": "SELECT id, price FROM products ORDER BY price DESC, id ASC;",
    "nodes": [
      {
        "id": "topic",
        "label": "让排序规则完整",
        "description": "示例只输出编号和价格，按价格降序、编号升序排列；题目还要求名称。"
      },
      {
        "id": "primary",
        "label": "先比较价格\nprice DESC",
        "description": "DESC 表示从高到低，每个排序键的方向单独书写；SELECT 的字段先后不决定行排序。"
      },
      {
        "id": "tie",
        "label": "同价再比较编号\nid ASC",
        "description": "只有价格相同时才比较 id；编号唯一且升序，使同价商品的先后稳定。"
      },
      {
        "id": "null",
        "label": "未知价格排最后",
        "description": "SQLite 默认把 NULL 看作小于非 NULL，价格降序时未知价格位于末尾；多个 NULL 仍按 id 升序。"
      },
      {
        "id": "scope",
        "label": "排序不筛行",
        "description": "没有 WHERE 或 LIMIT，免费、无库存和未知价格商品都参与。索引和预览顺序不能替代 ORDER BY。"
      }
    ],
    "edges": [
      {
        "from": "topic",
        "to": "primary"
      },
      {
        "from": "topic",
        "to": "tie"
      },
      {
        "from": "topic",
        "to": "null"
      },
      {
        "from": "topic",
        "to": "scope"
      }
    ]
  },
  "hints": [
    {
      "id": "idea",
      "text": "先让价格越高越靠前，再用唯一编号解决同价。"
    },
    {
      "id": "syntax",
      "text": "ORDER BY price DESC, id ASC；方向分别属于各自字段。"
    },
    {
      "id": "skeleton",
      "text": "SELECT id, name, price FROM products ORDER BY price ____, id ____;"
    }
  ],
  "referenceSolutions": [
    {
      "sql": "SELECT id, name, price FROM products ORDER BY price DESC, id ASC;",
      "explanation": "价格降序把未知价格放在末尾；id 升序明确每个同价组及 NULL 组的顺序。"
    }
  ],
